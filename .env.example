# API (apps/api). Copia este archivo a apps/api/.env para personalizarlo.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# SQLite local. En produccion: URL de Turso (libsql://...) + token.
DATABASE_URL=file:./data/dev.db
DATABASE_AUTH_TOKEN=

# Origen publico de la web, tal y como lo ve el navegador (sin barra final).
# En desarrollo la web va por Vite, asi que es http://localhost:5173 (no 127.0.0.1).
APP_URL=http://localhost:5173

# Clave con la que Better Auth firma las cookies de sesion. En produccion es OBLIGATORIA y debe
# tener 32+ caracteres aleatorios. Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# En desarrollo puede quedar vacia (se usa una clave fija de desarrollo).
BETTER_AUTH_SECRET=

# Abre/cierra el registro de usuarios nuevos. Sin valor queda abierto en desarrollo y CERRADO en
# produccion: para crear las cuentas en produccion ponlo a true y despues vuelve a false.
ALLOW_SIGNUP=true
